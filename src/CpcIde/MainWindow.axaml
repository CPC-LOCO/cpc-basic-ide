<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="CpcIde.MainWindow"
        Title="CPC BASIC IDE"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400">

    <Window.Styles>
        <!-- Gros boutons : hauteur d'au moins 48 points, texte de 18 -->
        <Style Selector="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Messages : un peu d'air autour de chaque ligne -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Message choisi : fond jaune vif, texte noir (très lisible, quel que soit le thème de Windows) -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Même réglage par les couleurs du thème, au cas où un état ne serait pas couvert plus haut -->
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelected">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPressed">#000000</SolidColorBrush>
    </Window.Resources>

    <DockPanel>
        <!-- Barre de boutons en haut : elle passe à la ligne si la fenêtre est étroite -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,0">
            <Button Content="Ouvrir (Ctrl+O)" Click="OnOpenClick" />
            <Button Content="Enregistrer (Ctrl+S)" Click="OnSaveClick" />
            <Button Content="Compiler (F5)" Click="OnCompileClick" />
            <Button Content="Texte plus petit (Ctrl+-)" Click="OnSmallerClick" />
            <Button Content="Texte plus grand (Ctrl++)" Click="OnBiggerClick" />
            <Button x:Name="ContrastButton" Content="Contraste élevé : non (Ctrl+H)" Click="OnContrastClick" />
        </WrapPanel>

        <!-- Barre d'état tout en bas -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="#202020" Padding="8,4">
            <TextBlock x:Name="StatusText" Foreground="#C0C0C0"
                       AutomationProperties.Name="Barre d'état" />
        </Border>

        <!-- Panneau des messages : erreurs, ou résultat de la compilation.
             Flèches : changer de message (le curseur de l'éditeur suit). Entrée ou clic : aller dans l'éditeur. -->
        <ListBox x:Name="MessageList"
                 DockPanel.Dock="Bottom"
                 Height="160"
                 Background="#101010"
                 Foreground="#E0E0E0"
                 FontSize="16"
                 AutomationProperties.Name="Messages du compilateur"
                 SelectionChanged="OnMessageSelected"
                 Tapped="OnMessageTapped"
                 KeyDown="OnMessageKeyDown" />

        <!-- Éditeur : papier bleu et stylo jaune, comme le MODE 1 du CPC -->
        <AvaloniaEdit:TextEditor x:Name="Editor"
                                 ShowLineNumbers="True"
                                 FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                 FontSize="16"
                                 Background="#000080"
                                 Foreground="#FFFF00"
                                 AutomationProperties.Name="Éditeur du programme BASIC"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
