<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="CpcIde.MainWindow"
        Title="CPC BASIC IDE"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400">

    <Window.Styles>
        <!-- Boutons compacts mais lisibles : 36 points de haut, texte de 16 -->
        <Style Selector="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Messages : un peu d'air autour de chaque ligne, sans perdre trop de place -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- Message choisi : fond jaune vif, texte noir (très lisible, quel que soit le thème de Windows) -->
        <!-- Message sous la souris : fond gris foncé, texte blanc (le thème clair mettait le texte en noir sur noir) -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFF00" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Même réglage par les couleurs du thème, au cas où un état ne serait pas couvert plus haut -->
        <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver">#404040</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundPointerOver">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed">#FFFF00</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelected">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPressed">#000000</SolidColorBrush>
    </Window.Resources>

    <DockPanel>
        <!-- Barre de menus Windows (D112) : Alt ouvre les menus, les lettres soulignées les choisissent ; les raccourcis
             (Ctrl+O, F5, F8...) restent les mêmes. Les réglages sont cochés quand ils sont actifs. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="15">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Ouvrir..." InputGesture="Ctrl+O" Click="OnOpenClick" />
                <MenuItem Header="_Enregistrer" InputGesture="Ctrl+S" Click="OnSaveClick" />
                <MenuItem Header="Enregistrer _sous..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClick" />
                <Separator />
                <MenuItem Header="_Préparer un dossier à distribuer..." Click="OnDistributeClick" />
                <Separator />
                <MenuItem Header="_Quitter" InputGesture="Alt+F4" Click="OnQuitClick" />
            </MenuItem>
            <!-- Menu Édition (D121) : les raccourcis sont ceux de l'éditeur de texte, le menu les rappelle -->
            <MenuItem Header="_Édition">
                <MenuItem Header="_Annuler" InputGesture="Ctrl+Z" Click="OnUndoClick" />
                <MenuItem Header="_Rétablir" InputGesture="Ctrl+Y" Click="OnRedoClick" />
                <Separator />
                <MenuItem Header="Co_uper" InputGesture="Ctrl+X" Click="OnCutClick" />
                <MenuItem Header="_Copier" InputGesture="Ctrl+C" Click="OnCopyClick" />
                <MenuItem Header="C_oller" InputGesture="Ctrl+V" Click="OnPasteClick" />
                <Separator />
                <MenuItem Header="_Tout sélectionner" InputGesture="Ctrl+A" Click="OnSelectAllClick" />
            </MenuItem>
            <MenuItem Header="_Compiler">
                <MenuItem Header="_Compiler le programme" InputGesture="F5" Click="OnCompileClick" />
                <MenuItem Header="_Vérifier sans enregistrer" InputGesture="Shift+F5" Click="OnVerifyClick" />
                <MenuItem Header="_Liste des variables" InputGesture="F4" Click="OnVariablesClick" />
            </MenuItem>
            <MenuItem Header="_Assembleur">
                <MenuItem Header="_Nouveau programme assembleur" Click="OnAsmNewClick" />
                <MenuItem Header="_Ouvrir un programme assembleur..." Click="OnAsmOpenClick" />
            </MenuItem>
            <MenuItem Header="_Bibliothèques">
                <MenuItem Header="_Liste des bibliothèques" InputGesture="Shift+F4" Click="OnLibrariesClick" />
            </MenuItem>
            <MenuItem Header="_Options">
                <!-- D126 : le texte dit la version actuelle, F7 passe de l'une à l'autre -->
                <MenuItem x:Name="VersionMenu" Header="Version du _CPC : français (AZERTY)" InputGesture="F7"
                          Click="OnVersionClick" />
                <!-- Pas de coche ici : le texte dit l'état actuel (entières ou à virgule), F8 passe de l'un à l'autre -->
                <MenuItem x:Name="RealMenu" Header="_Variables sans signe (A, X...) : entières" InputGesture="F8"
                          Click="OnRealClick" />
                <MenuItem x:Name="BreakMenu" Header="Touche _ESC comme le CPC" InputGesture="F9"
                          ToggleType="CheckBox" Click="OnBreakClick" />
                <MenuItem x:Name="TextMenu" Header="_Texte du programme sur la disquette" InputGesture="F11"
                          ToggleType="CheckBox" Click="OnTextClick" />
                <MenuItem x:Name="DebugMenu" Header="_Mise au point (DEBUG)" InputGesture="F2"
                          ToggleType="CheckBox" Click="OnDebugClick" />
                <MenuItem x:Name="PriorityMenu" Header="_Priorité : vitesse" InputGesture="F3" Click="OnPriorityClick" />
                <Separator />
                <MenuItem x:Name="WrapMenu" Header="_Lignes longues sur plusieurs lignes, comme le CPC"
                          ToggleType="CheckBox" Click="OnWrapClick" />
                <MenuItem x:Name="ContrastMenu" Header="Contraste é_levé" InputGesture="Ctrl+H"
                          ToggleType="CheckBox" Click="OnContrastClick" />
                <MenuItem Header="Texte plus _grand (Ctrl et +)" Click="OnBiggerClick" />
                <MenuItem Header="Texte plus _petit (Ctrl et -)" Click="OnSmallerClick" />
                <MenuItem Header="Taille du texte _normale (Ctrl et 0)" Click="OnNormalSizeClick" />
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_Raccourcis clavier" InputGesture="F1" Click="OnShortcutsClick" />
                <MenuItem Header="À _propos" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Barre d'état tout en bas (D113) : claire comme sous Windows, avec seulement la position du curseur
             à gauche et la largeur visible à droite (les réglages se lisent dans le menu Options). -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="#F0F0F0"
                BorderBrush="#C8C8C8" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#000000" FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Position du curseur" />
                <TextBlock x:Name="StatusRight" Grid.Column="1" Foreground="#000000" FontSize="14"
                           Margin="20,0,0,0"
                           AutomationProperties.Name="Largeur visible de l'éditeur" />
            </Grid>
        </Border>

        <!-- Éditeur en haut, panneau des messages en bas ; la barre entre les deux se tire à la souris
             pour agrandir ou réduire les messages (D113). -->
        <Grid x:Name="WorkArea" RowDefinitions="*,Auto,170">
            <!-- Éditeur : papier bleu et stylo jaune, comme le MODE 1 du CPC -->
            <AvaloniaEdit:TextEditor x:Name="Editor" Grid.Row="0"
                                     ShowLineNumbers="True"
                                     FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                     FontSize="16"
                                     Background="#000080"
                                     Foreground="#FFFF00"
                                     AutomationProperties.Name="Éditeur du programme BASIC"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />

            <GridSplitter x:Name="MessageSplitter" Grid.Row="1" Height="6"
                          ResizeDirection="Rows" Background="#808080"
                          AutomationProperties.Name="Séparation entre l'éditeur et les messages" />

            <!-- Panneau des messages : erreurs, ou résultat de la compilation. Les longues phrases passent
                 à la ligne au lieu d'être coupées. Flèches : changer de message (le curseur de l'éditeur suit).
                 Entrée ou clic : aller dans l'éditeur. -->
            <ListBox x:Name="MessageList" Grid.Row="2"
                     MinHeight="60"
                     Background="#101010"
                     Foreground="#E0E0E0"
                     FontSize="16"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Messages du compilateur"
                     SelectionChanged="OnMessageSelected"
                     Tapped="OnMessageTapped"
                     KeyDown="OnMessageKeyDown" />
        </Grid>
    </DockPanel>
</Window>
