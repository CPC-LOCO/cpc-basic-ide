10 REM Essai de TIME, AFTER, EVERY et ON SQ sur la cartouche GX4000 (D194)
20 MODE 1:FINI=0
30 PRINT "EVERY : UN POINT PAR SECONDE"
40 PRINT "AFTER : UN MESSAGE APRES 5 SECONDES"
50 T=TIME:EVERY 50 GOSUB 200:AFTER 250,1 GOSUB 300
60 WHILE FINI=0:WEND
70 U=TIME:PRINT "TIME A MESURE :";(U-T)ç300;"SECONDES"
80 PRINT:PRINT "ON SQ : UNE MELODIE QUI SE"
90 PRINT "REMPLIT TOUTE SEULE"
100 RESTORE 500:ON SQ(1) GOSUB 400
110 PRINT:PRINT "TIR 1 : FIN"
120 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
130 END
200 PRINT ".";:RETURN
300 FINI=1:R=REMAIN(0):PRINT:PRINT "5 SECONDES : AFTER EST ARRIVE":RETURN
400 READ P:IF P=0 THEN RESTORE 500:READ P
410 SOUND 1,P,20,12:ON SQ(1) GOSUB 400:RETURN
500 DATA 478,379,319,239,319,379,0
