10 REM ACCEPT (D223) : saisie limitee a certains caracteres, longueur facultative
20 MODE 1:INK 0,1:INK 1,24:PEN 1:CLS
30 ACCEPT "0123456789", 3, "VOTRE AGE (3 CHIFFRES AU PLUS) : ", A
40 PRINT "  VOUS AVEZ";A;"ANS":PRINT
50 L$="ABCDEFGHIJKLMNOPQRSTUVWXYZ":L$=L$+LOWER$(L$)
60 ACCEPT L$+" -", 12, "VOTRE NOM (LETTRES) : ", N$
70 PRINT "  BONJOUR ";N$:PRINT
80 ACCEPT "ONon", 1, "ON CONTINUE (O/N) "; R$
90 IF UPPER$(R$)="O" THEN PRINT "  OUI !" ELSE PRINT "  TANT PIS"
100 PRINT:PRINT "APPUYEZ SUR ESPACE"
110 CLIC 32
120 RUN
