10 MODE 1:C=0
20 PRINT "REMAIN(3) =";REMAIN(3)
30 EVERY 25,1 GOSUB 100
40 AFTER 100,2 GOSUB 200
50 T=TIME
60 IF TIME-T<900 THEN 60
70 R=REMAIN(1)
80 PRINT "FIN C=";C;" R=";R
90 FOR K=1 TO 2000:NEXT
95 PRINT "C=";C;" (PLUS DE TIC)"
96 FOR J = 1 TO 1 : FOR K = 1 TO 30000 : NEXT : NEXT
97 PRINT "APPUYEZ SUR UNE TOUCHE"
99 END
100 C=C+1:PRINT "TIC";C:RETURN
200 PRINT "AU BOUT DE 2 SECONDES":RETURN
