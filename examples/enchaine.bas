10 MODE 1
20 ON ERROR GOTO 200
30 OPENIN "COMPTE":INPUT #9,N:CLOSEIN
40 ON ERROR GOTO 0
50 N=N+1:PRINT "LANCEMENT NUMERO";N
60 OPENOUT "COMPTE":PRINT #9,N:CLOSEOUT
70 IF N>=3 THEN 100
80 PRINT "JE ME RELANCE...":FOR J=1 TO 3:FOR K=1 TO 30000:NEXT:NEXT
90 RUN "ENCHAINE"
100 PRINT "FINI : 3 LANCEMENTS"
110 OPENOUT "COMPTE":PRINT #9,0:CLOSEOUT
120 PRINT "APPUYEZ SUR UNE TOUCHE"
130 END
200 N=0:RESUME 40
