10 REM POKE, PEEK, CALL et INP
20 MODE 1
30 POKE 30000, 65 : POKE 30001, 66
40 PRINT "PEEK(30000) = "; PEEK(30000)
50 PRINT "PEEK(30001) = "; PEEK(30001)
60 REM Une petite routine en langage machine : LD A,42 / CALL &BB5A / RET
70 POKE 30010, 62 : POKE 30011, 42 : POKE 30012, 205
80 POKE 30013, 90 : POKE 30014, 187 : POKE 30015, 201
90 PRINT "CALL 30010 AFFICHE : ";
100 CALL 30010
110 PRINT
120 PRINT "INP(62720) = "; INP(62720)
130 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
140 REM Une ligne ecrite directement dans la memoire ecran (adresse 49152)
150 FOR I = 0 TO 79 : POKE -16384 + I, 255 : NEXT
160 FOR J = 1 TO 2 : FOR I = 1 TO 30000 : NEXT : NEXT
170 PRINT "APPUYEZ SUR UNE TOUCHE"
180 END
