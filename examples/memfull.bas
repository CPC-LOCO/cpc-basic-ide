10 MODE 1
20 PRINT "HIMEM :";HIMEM
30 MEMORY HIMEM-1000:PRINT "MEMORY HIMEM-1000 :";HIMEM
40 T=TIME:WHILE TIME-T<300:WEND
50 ON ERROR GOTO 100
60 M=&A67C:MEMORY M
70 END
100 PRINT "MEMORY &A67C :";ERR;"(Memory full)":RESUME 110
110 T=TIME:WHILE TIME-T<600:WEND
120 PRINT "APPUYEZ SUR UNE TOUCHE":END
