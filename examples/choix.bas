10 REM Essai de SELECT CASE (D206)
20 MODE 1:INK 0,1:INK 1,24:INK 2,20:INK 3,6:PEN 1
25 WHILE INKEY(47)=0:WEND:WHILE INKEY$<>"":WEND
30 PRINT "SELECT CASE : TAPEZ UN CHIFFRE"
40 PRINT "OU UNE LETTRE (ESPACE POUR FINIR)":PRINT
50 K$=INKEY$:IF K$="" THEN 50
60 IF K$=" " THEN 200
70 SELECT K$
80 CASE "0" TO "9"
90 N=VAL(K$)
100 SELECT N
110 CASE 0:PEN 1:PRINT K$;" : ZERO"
120 CASE 1,3,5,7,9:PEN 2:PRINT K$;" : IMPAIR"
130 CASE ELSE:PEN 3:PRINT K$;" : PAIR"
140 END SELECT
150 CASE "A","E","I","O","U","Y","a","e","i","o","u","y":PEN 1:PRINT K$;" : VOYELLE"
160 CASE "A" TO "Z","a" TO "z":PEN 2:PRINT K$;" : CONSONNE"
170 CASE ELSE:PEN 3:PRINT K$;" : AUTRE TOUCHE"
180 END SELECT
190 PEN 1:GOTO 50
200 PRINT:PRINT "FIN. APPUYEZ SUR ESPACE"
210 WHILE INKEY(47)=0:WEND:WHILE INKEY(47):WEND
220 GOTO 20
