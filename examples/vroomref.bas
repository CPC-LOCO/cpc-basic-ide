10 REM VROOM : essai des trois sons, en SOUND, ENV et ENT (avant la commande VROOM)
20 MODE 1:INK 0,1:INK 1,24:PEN 1
30 ENT 1,100,-5,1
40 ENT -2,5,8,1,5,-8,1
50 ENV 2,3,-4,4,3,4,4
60 ENT 3,33,5,1:ENT 4,33,5,1:ENT 5,34,5,1
70 ENV 3,2,-6,2,2,6,2
80 ENV 4,2,-4,2,2,4,2:ENV 5,2,-2,2,2,2,2
90 CLS:PRINT "VROOM : ESSAI DES TROIS SONS":PRINT
100 PRINT "1 : MOTEUR QUI MONTE"
110 PRINT "2 : RALENTI"
120 PRINT "3 : MOTEUR QUI DESCEND":PRINT
130 PRINT "TAPEZ 1, 2 OU 3"
140 K$=INKEY$:IF K$="" THEN 140
150 IF K$="1" THEN SOUND 1,900,-13,12,3,1,25
160 IF K$="2" THEN SOUND 1,900,-6,12,2,2,25
170 IF K$="3" THEN SOUND 1,400,-4,12,3,3,25:SOUND 1,565,-4,8,4,4,25:SOUND 1,730,-5,4,5,5,25
180 GOTO 140
