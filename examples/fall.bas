10 REM FALL son (D217) : 1 chute dans le vide puis le sol, 2 vie perdue
20 MODE 1:INK 0,1:INK 1,24:PEN 1
30 CLS:PRINT "FALL : LES DEUX SONS":PRINT
40 PRINT "1 : FALL 1 (CHUTE, PUIS LE SOL)"
50 PRINT "2 : FALL 2 (VIE PERDUE)"
60 PRINT "3 : TIR, EXPLOSION, VIE PERDUE":PRINT
70 PRINT "TAPEZ 1, 2 OU 3"
80 K$=INKEY$:IF K$="" THEN 80
90 N=VAL(K$)
100 IF N=1 OR N=2 THEN FALL N
110 IF N=3 THEN SHOT 1:BOOM 3:FALL 2
120 GOTO 80
