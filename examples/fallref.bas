10 REM FALL : essai des quatre sons, en SOUND, ENV et ENT (avant la commande FALL)
20 MODE 1:INK 0,1:INK 1,24:PEN 1
30 ENT 1,50,1,5
40 ENT 2,100,6,1
50 ENV 1,15,-1,1
60 ENV 2,6,-2,1
70 ENV 3,12,-1,5
80 ENT -3,2,2,1,2,-2,1
85 ENV 4,8,1,30
90 CLS:PRINT "FALL : ESSAI DES QUATRE SONS":PRINT
100 PRINT "1 : UNE BOMBE QUI TOMBE"
110 PRINT "2 : CHUTE DANS LE VIDE, PUIS LE SOL"
120 PRINT "3 : OBJET QUI DEGRINGOLE UN ESCALIER"
130 PRINT "4 : UNE VIE PERDUE":PRINT
140 PRINT "TAPEZ 1, 2, 3 OU 4"
150 K$=INKEY$:IF K$="" THEN 150
160 ON VAL(K$) GOSUB 180,190,200,220
170 GOTO 150
180 SOUND 1,30,250,6,4,1:RETURN
190 SOUND 1,100,100,12,0,2:SOUND 1,2000,15,15,1,0,25:RETURN
200 FOR I=0 TO 5:SOUND 1,300+I*60,6,12,2,0,15:SOUND 1,0,4,0:NEXT
210 RETURN
220 SOUND 1,239,25,12:SOUND 1,253,25,12:SOUND 1,268,25,12:SOUND 1,284,60,12,3,3:RETURN
