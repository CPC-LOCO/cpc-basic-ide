10 REM Lot E3b : tableaux de textes et MID$ =
20 MODE 1
30 DIM JOUR$(6)
40 FOR I = 0 TO 6 : READ JOUR$(I) : NEXT
50 FOR I = 0 TO 6 : PRINT LEFT$(JOUR$(I), 3); " "; : NEXT : PRINT
60 PRINT "LE 3E JOUR : "; JOUR$(2)
70 A$ = "BONJOUR"
80 MID$(A$, 4, 4) = "SOIR"
90 PRINT "BONJOUR DEVIENT "; A$
100 DIM GRILLE$(2, 2)
110 FOR L = 0 TO 2 : FOR C = 0 TO 2 : GRILLE$(L, C) = "." : NEXT : NEXT
120 GRILLE$(1, 1) = "X" : GRILLE$(0, 2) = "O"
130 FOR L = 0 TO 2 : FOR C = 0 TO 2 : PRINT GRILLE$(L, C); : NEXT : PRINT : NEXT
140 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
150 PRINT "APPUYEZ SUR UNE TOUCHE"
160 END
170 DATA LUNDI, MARDI, MERCREDI, JEUDI, VENDREDI, SAMEDI, DIMANCHE
