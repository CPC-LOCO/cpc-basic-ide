10 MODE 1
20 X=100
30 DEF FNDOUBLE(X)=X*2
40 DEF FNA$(N$)=N$+"!"
50 DEF FNR=X+1
60 DEF FNM(A,B)=A*B+X
70 DEF FNMOITIE!(V!)=V!/2
80 PRINT "FNDOUBLE(21) ET X :";FNDOUBLE(21);X
90 PRINT FNA$("BONJOUR")
100 PRINT "FNR ET FN R :";FNR;FN R
110 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
120 PRINT "FNM(2,3) :";FNM(2,3)
130 PRINT "FNMOITIE!(3) :";FNMOITIE!(3)
140 PRINT "FNM(FNM(1,1),2) :";FNM(FNM(1,1),2)
150 FOR J = 1 TO 2 : FOR I = 1 TO 30000 : NEXT : NEXT
160 PRINT "APPUYEZ SUR UNE TOUCHE"
170 END
