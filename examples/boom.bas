10 REM BOOM son [, duree] (D214) : 1 voiture, 2 feu d'artifice, 3 petard, 4 marteau, 5 malus
20 MODE 1:INK 0,1:INK 1,24:PEN 1
30 CLS:PRINT "BOOM : LES CINQ SONS":PRINT
40 PRINT "1 : BOOM 1 (VOITURE QUI EXPLOSE)"
50 PRINT "2 : BOOM 2 (FEU D'ARTIFICE)"
60 PRINT "3 : BOOM 3 (PETARD, COUP DE FUSIL)"
70 PRINT "4 : BOOM 4 (MARTEAU QUI FRAPPE)"
80 PRINT "5 : BOOM 5 (MALUS)"
90 PRINT "6 : BOOM 1,500 (EXPLOSION LONGUE)"
100 PRINT "7 : BOOM 5,300 (MALUS LONG)":PRINT
110 PRINT "TAPEZ 1 A 7"
120 K$=INKEY$:IF K$="" THEN 120
130 N=VAL(K$)
140 IF N>=1 AND N<=5 THEN BOOM N
150 IF N=6 THEN BOOM 1,500
160 IF N=7 THEN BOOM 5,300
170 GOTO 120
