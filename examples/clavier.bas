10 REM INKEY, JOY et CLEAR INPUT : les valeurs se mettent a jour en continu
20 MODE 1
30 PRINT "ESSAYEZ ESPACE (TOUCHE 47) ET LA MANETTE"
40 PRINT "APPUYEZ SUR ENTREE (TOUCHE 18) POUR FINIR"
50 CLEAR INPUT
60 LOCATE 1, 5 : PRINT "INKEY(47) = "; INKEY(47); "    "
70 LOCATE 1, 7 : PRINT "JOY(0) = "; JOY(0); "    "
80 LOCATE 1, 9 : PRINT "JOY(1) = "; JOY(1); "    "
90 IF INKEY(18) < 0 THEN 60
100 CLEAR INPUT
110 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
120 LOCATE 1, 12 : PRINT "FIN DU TEST"
130 FOR J = 1 TO 2 : FOR I = 1 TO 30000 : NEXT : NEXT
140 LOCATE 1, 14 : PRINT "APPUYEZ SUR UNE TOUCHE"
150 END
