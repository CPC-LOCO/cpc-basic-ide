120 PRINT "LIBRE APRES LE MENAGE :";FRE("")
130 FOR J = 1 TO 2 : FOR I = 1 TO 30000 : NEXT : NEXT
140 PRINT "APPUYEZ SUR UNE TOUCHE"
150 END
