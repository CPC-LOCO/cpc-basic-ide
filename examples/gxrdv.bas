10 REM Essai des sons retenus et des rendez-vous sur la cartouche GX4000 (D195)
20 MODE 1:PRINT "UN SON RETENU : IL ATTEND RELEASE"
30 SOUND 1+64,319,100,12
40 PRINT "TIR 1 : RELEASE"
50 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
60 RELEASE 1
70 GOSUB 300
80 PRINT:PRINT "RENDEZ-VOUS : A JOUE 3 NOTES,"
90 PRINT "PUIS UN ACCORD AVEC C"
100 SOUND 1,478,40:SOUND 1,426,40:SOUND 1,379,40
110 SOUND 1+32,319,100:SOUND 4+8,239,100
120 GOSUB 300
130 PRINT:PRINT "B JOUE SEUL, PUIS A ET B ENSEMBLE"
140 SOUND 2,600,150,8:SOUND 3,478,50
150 GOSUB 300
160 PRINT:PRINT "FIN"
170 END
300 PRINT "TIR 1 : SUITE"
310 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
320 RETURN
