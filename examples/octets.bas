10 REM Tableaux d'octets (D221) : BYTE T avant DIM T(...) : cases de 0 a 255, moitie moins de memoire
20 BYTE T
30 MODE 1:INK 0,1:INK 1,24:PEN 1:CLS
40 M=FRE(0):DIM N(5000):A=M-FRE(0)
50 M=FRE(0):DIM T(5000):B=M-FRE(0)
60 PRINT "DIM N(5000), ENTIERS :";A;"OCTETS"
70 PRINT "DIM T(5000), BYTE   :";B;"OCTETS":PRINT
80 FOR I=0 TO 5000:T(I)=I:NEXT
90 PRINT "T(10) =";T(10)
100 PRINT "T(300) =";T(300);"(300 = 256 + 44)"
110 PRINT "T(5000) =";T(5000):PRINT
120 PRINT "APPUYEZ SUR ESPACE"
130 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
140 RUN
