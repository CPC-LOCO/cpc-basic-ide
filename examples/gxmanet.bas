10 REM Essai des manettes sur la cartouche GX4000 (D183)
20 MODE 1
30 LOCATE 11,2:PRINT "ESSAI DES MANETTES"
40 LOCATE 1,4:PRINT "Bougez la manette 1 et appuyez"
50 LOCATE 1,22:PRINT "Tir 2 : touche Q (INKEY(67))"
60 LOCATE 1,23:PRINT "Tirs 1 et 2 tenus un moment : fin"
70 J=JOY(0)
80 LOCATE 1,7:PRINT "JOY(0) =";J;"   "
90 LOCATE 1,9:IF J AND 1 THEN PRINT "HAUT  " ELSE PRINT "      "
100 LOCATE 1,10:IF J AND 2 THEN PRINT "BAS   " ELSE PRINT "      "
110 LOCATE 1,11:IF J AND 4 THEN PRINT "GAUCHE" ELSE PRINT "      "
120 LOCATE 1,12:IF J AND 8 THEN PRINT "DROITE" ELSE PRINT "      "
130 LOCATE 1,14:IF INKEY(47)=0 THEN PRINT "TIR 1 = ESPACE" ELSE PRINT "              "
140 LOCATE 1,15:IF INKEY(18)=0 THEN PRINT "TIR 2 = ENTREE" ELSE PRINT "              "
150 LOCATE 1,17:IF INKEY(67)=0 THEN PRINT "TOUCHE Q" ELSE PRINT "        "
160 IF (J AND 48)=48 THEN N=N+1 ELSE N=0
170 IF N<50 THEN 70
180 CLS:PRINT "FIN DE L ESSAI":PRINT:PRINT "APPUYEZ SUR ESPACE (tir 1)"
190 WHILE INKEY(47)=0:WEND:WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
200 MODE 2:PRINT "AU REVOIR"
