10 REM SHOT : essai des quatre sons, en SOUND, ENV et ENT (avant la commande SHOT)
20 MODE 1:INK 0,1:INK 1,24:PEN 1
30 ENV 1,15,-1,2
40 ENT 1,30,9,1
50 ENV 2,10,1,4,15,-1,4
60 ENT 2,90,3,1
70 ENV 3,7,-2,1
80 ENV 4,15,-1,4
90 ENV 5,6,-2,1
100 CLS:PRINT "SHOT : ESSAI DES QUATRE SONS":PRINT
110 PRINT "1 : TIR DE LASER"
120 PRINT "2 : MISSILE"
130 PRINT "3 : RAFALE"
140 PRINT "4 : VITRE QUI CASSE":PRINT
150 PRINT "TAPEZ 1, 2, 3 OU 4"
160 K$=INKEY$:IF K$="" THEN 160
170 ON VAL(K$) GOSUB 190,200,210,220
180 GOTO 160
190 SOUND 1,30,30,15,1,1:RETURN
200 SOUND 1,0,100,5,2,0,3:SOUND 2,100,100,5,2,2:RETURN
210 FOR I=1 TO 6:SOUND 1,0,9,14,3,0,5:NEXT:RETURN
220 SOUND 1,0,60,15,4,0,1:SOUND 2,40,7,12,5:SOUND 2,55,7,12,5:SOUND 2,35,7,12,5:SOUND 2,60,7,12,5:SOUND 2,45,7,12,5:SOUND 2,50,7,12,5:RETURN
