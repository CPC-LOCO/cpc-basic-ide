10 REM Lot D : &, AND, OR, XOR, NOT, ^ et comparaisons
20 MODE 1
30 PRINT "&FF = "; &FF; "  &X1010 = "; &X1010
40 PRINT "&FFFF = "; &FFFF
50 PRINT "12 AND 10 = "; 12 AND 10
60 PRINT "12 OR 3 = "; 12 OR 3
70 PRINT "12 XOR 10 = "; 12 XOR 10
80 PRINT "NOT 0 = "; NOT 0
90 PRINT "2 ^ 10 = "; 2 ^ 10
100 PRINT "5 > 3 VAUT "; 5 > 3; " ET 5 < 3 VAUT "; 5 < 3
110 A = 7
120 IF A THEN PRINT "A N'EST PAS 0"
130 IF A AND 1 THEN PRINT "A EST IMPAIR"
140 P = &9000 : POKE P + 1, 99
150 PRINT "PEEK(&9001) = "; PEEK(&9001)
160 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
170 PRINT "APPUYEZ SUR UNE TOUCHE"
180 END
