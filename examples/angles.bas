10 MODE 1:DEG
20 PRINT "360 POINTS : SIN/COS PUIS ISIN/ICOS"
30 T!=TIME
40 FOR A%=0 TO 359:X%=COS(A%)*120:Y%=SIN(A%)*120:PLOT 160+X%,200+Y%,1:NEXT
50 S!=TIME-T!
60 T!=TIME
70 FOR A%=0 TO 359:PLOT 480+ICOS(A%,120),200+ISIN(A%,120),2:NEXT
80 I!=TIME-T!
90 LOCATE 1,22:PRINT "SIN ET COS   :";S!/300;"SECONDES"
100 PRINT "ISIN ET ICOS :";I!/300;"SECONDES"
110 LOCATE 1,25:PRINT "APPUYEZ SUR ESPACE";
120 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
