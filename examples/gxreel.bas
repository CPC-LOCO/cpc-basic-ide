10 REM Essai des nombres a virgule sur la cartouche GX4000 (D196)
20 MODE 1
30 A!=1.5:B!=2.25:PRINT "A+B =";A!+B!;"  A*B =";A!*B!
40 PRINT "10/3 =";10.0/3
50 PRINT "SQR(2) =";SQR(2)
60 PRINT "PI =";PI
70 PRINT "SIN(1) =";SIN(1)
80 PRINT "COS(1) =";COS(1)
90 PRINT "EXP(1) =";EXP(1)
100 PRINT "LOG(10) =";LOG(10)
110 PRINT "2^0.5 =";2^0.5;"  2^10 =";2^10
120 DEG:PRINT "SIN(30) =";SIN(30);"  ATN(1) =";ATN(1):RAD
130 FOR T!=0 TO 6.3 STEP 0.05:PLOT 320+80*COS(T!),120+80*SIN(T!),2:NEXT
140 LOCATE 1,25:PRINT "TIR 1 : FIN";
150 WHILE INKEY(47):WEND:WHILE INKEY(47)=0:WEND
