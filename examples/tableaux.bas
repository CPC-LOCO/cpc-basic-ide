10 REM DIM : tableaux d'entiers
20 MODE 1
30 DIM CARRE(6), GRILLE(2, 3)
40 FOR I = 0 TO 6 : CARRE(I) = I * I : NEXT
50 PRINT "CARRES : ";
60 FOR I = 0 TO 6 : PRINT CARRE(I); : NEXT : PRINT
70 FOR L = 0 TO 2 : FOR C = 0 TO 3 : GRILLE(L, C) = L * 10 + C : NEXT : NEXT
80 PRINT "GRILLE(2, 3) = "; GRILLE(2, 3)
90 PRINT "GRILLE(1, 0) = "; GRILLE(1, 0)
100 N = 5 : DIM SCORE(N)
110 SCORE(N) = 99
120 PRINT "SCORE(5) = "; SCORE(5)
130 PRINT "SANS DIM : VIDE(10) = "; VIDE(10)
140 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
150 PRINT "APPUYEZ SUR UNE TOUCHE"
160 END
