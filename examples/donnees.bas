10 REM DATA, READ et RESTORE
20 MODE 1
30 DIM JOUR(6)
40 FOR I = 0 TO 6 : READ JOUR(I) : NEXT
50 PRINT "TEMP : ";
60 FOR I = 0 TO 6 : PRINT JOUR(I); : NEXT : PRINT
70 T = 0 : FOR I = 0 TO 6 : T = T + JOUR(I) : NEXT
80 PRINT "TOTAL : "; T
90 RESTORE 200
100 READ X, Y
110 PRINT "RESTORE 200 : "; X; Y
120 RESTORE
130 READ X
140 PRINT "RESTORE : "; X
150 FOR J = 1 TO 1 : FOR I = 1 TO 30000 : NEXT : NEXT
160 PRINT "APPUYEZ SUR UNE TOUCHE"
170 END
180 DATA 12, 15, -3, 0
190 DATA 8, 21, 17
200 DATA 1000, 2000
